{
  "name": "@shm/journey-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "verify:local": "esbuild verification/run.ts --bundle --platform=node --format=esm --outfile=.generated/verify.mjs --banner:js=\"import {createRequire} from 'node:module'; const require=createRequire(import.meta.url);\" && node .generated/verify.mjs"
  },
  "dependencies": {
    "@seed-hypermedia/client": "workspace:*",
    "@shm/ui": "workspace:*",
    "@xstate/react": "4.1.3",
    "lucide-react": "^0.358.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xstate": "5.19.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "typescript": "5.8.3",
    "esbuild": "0.27.2",
    "jsdom": "24.1.3",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  }
}
