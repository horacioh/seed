{
  "name": "@shm/a11y-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dom": {
      "types": "./src/dom.ts",
      "default": "./src/dom.ts"
    },
    "./playwright": {
      "types": "./src/playwright.ts",
      "default": "./src/playwright.ts"
    }
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "test:screen-reader": "playwright test --config=playwright.screen-reader.config.ts",
    "typecheck:screen-reader": "tsc --noEmit --project screen-reader/tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.app.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@guidepup/guidepup": "0.34.0",
    "@guidepup/playwright": "0.19.1",
    "@guidepup/setup": "0.28.0",
    "@playwright/test": "1.57.0",
    "axe-core": "4.13.0",
    "jsdom": "^24.1.3",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@playwright/test": "1.57.0"
  }
}
