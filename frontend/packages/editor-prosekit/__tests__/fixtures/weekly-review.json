        },
        "annotations": [],
        "text": "What I shipped",
        "link": ""
      }
    },
    {
      "children": [
        {
          "children": [],
          "block": {
            "type": "Paragraph",
            "id": "HqkH0clI",
            "revision": "bafyreia7bwnixljpmmhubsrorscx3aua5k5i4f642pgvp4tywxsvlgga6a",
            "attributes": {},
            "annotations": [
              {
                "type": "Bold",
                "starts": [78],
                "ends": [111],
                "attributes": {},
                "link": ""
              }
            ],
            "text": "A lot of the work was small on its own, but it all pointed at the same thing: publishing should feel continuous. The user should be able to copy a link, move a document, edit a caption, or promote a collaborator without wondering which subsystem they accidentally crossed into.",
            "link": ""
          }
        },
        {
          "children": [
            {
              "children": [],
              "block": {
                "type": "Paragraph",
                "id": "XLINwREO",
                "revision": "bafyreia7bwnixljpmmhubsrorscx3aua5k5i4f642pgvp4tywxsvlgga6a",
                "attributes": {},
                "annotations": [
                  {
                    "type": "Italic",
                    "starts": [0],
                    "ends": [109],
                    "attributes": {},
                    "link": ""
                  }
                ],
                "text": "How many separate document actions can we collapse into one destination model before it becomes too abstract?",
                "link": ""
              }
            }
          ],
          "block": {
            "type": "Paragraph",
            "id": "tjrfsLlM",
            "revision": "bafyreia7bwnixljpmmhubsrorscx3aua5k5i4f642pgvp4tywxsvlgga6a",
