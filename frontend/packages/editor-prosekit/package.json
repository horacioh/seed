{
  "name": "@shm/editor-prosekit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vite --config harness/vite.config.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit --project tsconfig.app.json"
  },
  "dependencies": {
    "@seed-hypermedia/client": "workspace:*",
    "@shm/shared": "workspace:*",
    "@shm/ui": "workspace:*",
    "prosekit": "0.22.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.2.64",
    "@types/react-dom": "18.2.21",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.0.0",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vitest": "4.1.8"
  }
}
