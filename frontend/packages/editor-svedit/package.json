{
  "name": "@shm/editor-svedit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vite --config harness/vite.config.ts",
    "build:harness": "vite build --config harness/vite.config.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && svelte-check --tsconfig ./tsconfig.app.json --threshold error"
  },
  "dependencies": {
    "@seed-hypermedia/client": "workspace:*",
    "@shm/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svedit": "0.15.1",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@shm/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/react": "18.2.64",
    "@types/react-dom": "18.2.21",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.0.0",
    "prettier-plugin-svelte": "3.5.2",
    "svelte-check": "4.7.7",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vitest": "4.1.8"
  }
}
